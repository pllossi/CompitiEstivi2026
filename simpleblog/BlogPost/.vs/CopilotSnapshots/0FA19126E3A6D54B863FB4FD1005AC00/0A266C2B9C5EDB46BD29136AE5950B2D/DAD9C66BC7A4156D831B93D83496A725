<Window x:Class="WpfUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfUI"
        xmlns:vm="clr-namespace:WpfUI.ViewModel"
        xmlns:converters="clr-namespace:WpfUI.Converters"
        mc:Ignorable="d"
        Title="Blog Manager" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <converters:DateTimeToDateOnlyConverter x:Key="DateTimeToDateOnlyConverter"/>
        
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="5,5,5,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Titolo principale -->
        <TextBlock Grid.Row="0" 
                   Text="Gestione Blog" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>
        
        <!-- Contenuto principale -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Pannello sinistra: Form e Ricerca -->
            <Border Grid.Column="0" 
                    BorderBrush="LightGray" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="10"
                    Margin="0,0,5,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Sezione CRUD -->
                        <GroupBox Header="Gestione Articoli" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <Label Content="Titolo:"/>
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                                
                                <Label Content="Contenuto:"/>
                                <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="120" 
                                         TextWrapping="Wrap" 
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                                
                                <UniformGrid Columns="2" Margin="0,10,0,0">
                                    <Button Content="Crea" Command="{Binding CreateArticleCommand}"/>
                                    <Button Content="Aggiorna" Command="{Binding UpdateArticleCommand}"/>
                                    <Button Content="Elimina" Command="{Binding DeleteArticleCommand}"/>
                                    <Button Content="Pulisci" Command="{Binding ClearFormCommand}"/>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Sezione Ricerca -->
                        <GroupBox Header="Ricerca Articoli" Padding="10">
                            <StackPanel>
                                <!-- Ricerca per titolo -->
                                <Label Content="Ricerca per Titolo:"/>
                                <DockPanel>
                                    <Button Content="Cerca" 
                                            DockPanel.Dock="Right"
                                            Command="{Binding SearchByTitleCommand}"/>
                                    <TextBox Text="{Binding SearchTitle, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                
                                <!-- Ricerca per contenuto -->
                                <Label Content="Ricerca per Contenuto:"/>
                                <DockPanel>
                                    <Button Content="Cerca" 
                                            DockPanel.Dock="Right"
                                            Command="{Binding SearchByContentCommand}"/>
                                    <TextBox Text="{Binding SearchContent, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                
                                <!-- Ricerca per data -->
                                <Label Content="Ricerca per Data:"/>
                                <DockPanel>
                                    <Button Content="Cerca" 
                                            DockPanel.Dock="Right"
                                            Command="{Binding SearchByDateCommand}"/>
                                    <Button Content="Conta" 
                                            DockPanel.Dock="Right"
                                            Command="{Binding GetCountByDateCommand}"/>
                                    <DatePicker SelectedDate="{Binding SearchDate, Converter={StaticResource DateTimeToDateOnlyConverter}}"/>
                                </DockPanel>
                                
                                <!-- Ricerca per periodo -->
                                <Label Content="Ricerca per Periodo:"/>
                                <StackPanel>
                                    <DockPanel>
                                        <Label Content="Da:" Width="50" DockPanel.Dock="Left"/>
                                        <DatePicker SelectedDate="{Binding StartDate, Converter={StaticResource DateTimeToDateOnlyConverter}}"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <Label Content="A:" Width="50" DockPanel.Dock="Left"/>
                                        <DatePicker SelectedDate="{Binding EndDate, Converter={StaticResource DateTimeToDateOnlyConverter}}"/>
                                    </DockPanel>
                                    <Button Content="Cerca nel Periodo" 
                                            Command="{Binding SearchByPeriodCommand}"
                                            HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                
                                <!-- Pulsante ricarica tutti -->
                                <Button Content="Mostra Tutti gli Articoli" 
                                        Command="{Binding LoadArticlesCommand}"
                                        Margin="5,15,5,5"
                                        Background="LightBlue"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Pannello destra: Lista articoli -->
            <Border Grid.Column="1" 
                    BorderBrush="LightGray" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="10"
                    Margin="5,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Lista Articoli" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>
                    
                    <Button DockPanel.Dock="Top"
                            Content="Carica Selezionato per Modifica" 
                            Command="{Binding LoadSelectedArticleCommand}"
                            Margin="0,0,0,10"
                            Background="LightGreen"/>
                    
                    <DataGrid ItemsSource="{Binding Articles}"
                              SelectedItem="{Binding SelectedArticle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="AliceBlue">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" 
                                                Binding="{Binding Id}" 
                                                Width="80"/>
                            <DataGridTextColumn Header="Titolo" 
                                                Binding="{Binding Title}" 
                                                Width="*"/>
                            <DataGridTextColumn Header="Contenuto" 
                                                Binding="{Binding Content}" 
                                                Width="2*"/>
                            <DataGridTextColumn Header="Data Creazione" 
                                                Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}" 
                                                Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
        
        <!-- Barra di stato -->
        <Border Grid.Row="2" 
                Background="#F0F0F0" 
                BorderBrush="LightGray" 
                BorderThickness="0,1,0,0" 
                Padding="10,5"
                Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" 
                       FontStyle="Italic"/>
        </Border>
    </Grid>
</Window>
