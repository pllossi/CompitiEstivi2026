<Window x:Class="WpfUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfUI"
        xmlns:vm="clr-namespace:WpfUI.ViewModel"
        xmlns:converters="clr-namespace:WpfUI.Converters"
        mc:Ignorable="d"
        Title="Blog Manager" Height="750" Width="1400"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <converters:DateTimeToDateOnlyConverter x:Key="DateTimeToDateOnlyConverter"/>
        
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="5,5,5,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Main title -->
        <TextBlock Grid.Row="0" 
                   Text="Blog Management" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>
        
        <!-- Main content: 3 columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            
            <!-- LEFT COLUMN: Article list -->
            <Border Grid.Column="0" 
                    BorderBrush="LightGray" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="10"
                    Margin="0,0,5,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Article List" 
                               FontSize="18" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    
                    <DataGrid ItemsSource="{Binding Articles}"
                              SelectedItem="{Binding SelectedArticle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="AliceBlue"
                              HeadersVisibility="None"
                              RowHeight="55">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5">
                                            <TextBlock Text="{Binding Title}" 
                                                       FontWeight="Bold" 
                                                       FontSize="14"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}" 
                                                       FontSize="11"
                                                       Foreground="Gray"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            
            <!-- CENTER COLUMN: CRUD Form -->
            <Border Grid.Column="1" 
                    BorderBrush="LightGray" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="10"
                    Margin="5,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Article Management" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>
                        
                        <GroupBox Header="Article Data" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <Label Content="Title:"/>
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                                
                                <Label Content="Content:"/>
                                <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="250" 
                                         TextWrapping="Wrap" 
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <GroupBox Header="Operations" Padding="10">
                            <UniformGrid Columns="2">
                                <Button Content="Create New" 
                                        Command="{Binding CreateArticleCommand}"
                                        Background="LightGreen"/>
                                <Button Content="Update" 
                                        Command="{Binding UpdateArticleCommand}"
                                        Background="LightBlue"/>
                                <Button Content="Delete" 
                                        Command="{Binding DeleteArticleCommand}"
                                        Background="LightCoral"/>
                                <Button Content="Deselect" 
                                        Command="{Binding DeselectCommand}"
                                        Background="LightYellow"/>
                            </UniformGrid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- RIGHT COLUMN: Search filters -->
            <Border Grid.Column="2" 
                    BorderBrush="LightGray" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="10"
                    Margin="5,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Search Filters" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>
                        
                        <!-- Search by title -->
                        <GroupBox Header="Search by Title" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBox Text="{Binding SearchTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,5"/>
                                <Button Content="Search by Title" 
                                        Command="{Binding SearchByTitleCommand}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Search by content -->
                        <GroupBox Header="Search by Content" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBox Text="{Binding SearchContent, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,5"/>
                                <Button Content="Search by Content" 
                                        Command="{Binding SearchByContentCommand}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Search by date -->
                        <GroupBox Header="Search by Date" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <DatePicker SelectedDate="{Binding SearchDate, Converter={StaticResource DateTimeToDateOnlyConverter}}"
                                           Margin="0,0,0,5"/>
                                <UniformGrid Columns="2">
                                    <Button Content="Search" 
                                            Command="{Binding SearchByDateCommand}"/>
                                    <Button Content="Count" 
                                            Command="{Binding GetCountByDateCommand}"/>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Search by period -->
                        <GroupBox Header="Search by Period" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <Label Content="Start Date:" Margin="0"/>
                                <DatePicker SelectedDate="{Binding StartDate, Converter={StaticResource DateTimeToDateOnlyConverter}}"/>
                                
                                <Label Content="End Date:" Margin="0,10,0,0"/>
                                <DatePicker SelectedDate="{Binding EndDate, Converter={StaticResource DateTimeToDateOnlyConverter}}"/>
                                
                                <Button Content="Search in Period" 
                                        Command="{Binding SearchByPeriodCommand}"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Reload all button -->
                        <Button Content="Show All Articles" 
                                Command="{Binding LoadArticlesCommand}"
                                Margin="0,15,0,0"
                                Background="LightBlue"
                                FontWeight="Bold"
                                Height="40"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <!-- Status bar -->
        <Border Grid.Row="2" 
                Background="#F0F0F0" 
                BorderBrush="LightGray" 
                BorderThickness="0,1,0,0" 
                Padding="10,5"
                Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" 
                       FontStyle="Italic"
                       FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
