<Window x:Class="WpfUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfUI"
        xmlns:vm="clr-namespace:WpfUI.ViewModel"
        mc:Ignorable="d"
        Title="Blog Manager" Height="750" Width="1400"
        WindowStartupLocation="CenterScreen">
    
    <!-- Risorse della finestra: Stili globali -->
    <Window.Resources>
        
        <!-- Stile globale per tutti i pulsanti dell'applicazione -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        
        <!-- Stile globale per tutte le TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        
        <!-- Stile globale per tutti i DatePicker -->
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="5"/>
        </Style>
        
        <!-- Stile globale per tutte le Label -->
        <Style TargetType="Label">
            <Setter Property="Margin" Value="5,5,5,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    
    <!-- Grid principale con 3 righe: intestazione, contenuto, barra di stato -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>    <!-- Riga titolo -->
            <RowDefinition Height="*"/>       <!-- Riga contenuto (espandibile) -->
            <RowDefinition Height="Auto"/>    <!-- Riga barra di stato -->
        </Grid.RowDefinitions>
        
        <!-- RIGA 0: Titolo principale dell'applicazione -->
        <TextBlock Grid.Row="0" 
                   Text="Gestione Blog" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>
        
        <!-- RIGA 1: Contenuto principale diviso in 3 colonne -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>  <!-- Colonna lista articoli -->
                <ColumnDefinition Width="2*"/>  <!-- Colonna form CRUD -->
                <ColumnDefinition Width="2*"/>  <!-- Colonna filtri ricerca -->
            </Grid.ColumnDefinitions>
            
            <!-- COLONNA SINISTRA: Lista degli articoli -->
            <Border Grid.Column="0" 
                    BorderBrush="LightGray" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="10"
                    Margin="0,0,5,0">
                <DockPanel>
                    <!-- Intestazione della sezione -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="Article List" 
                               FontSize="18" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    
                    <!-- 
                        DataGrid per visualizzare la lista degli articoli.
                        - ItemsSource: collezione di articoli dal ViewModel
                        - SelectedItem: articolo selezionato (binding bidirezionale)
                        - Quando si clicca un articolo, viene caricato automaticamente nel form
                    -->
                    <DataGrid ItemsSource="{Binding Articles}"
                              SelectedItem="{Binding SelectedArticle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="AliceBlue"
                              HeadersVisibility="None"
                              RowHeight="55">
                        <DataGrid.Columns>
                            <!-- Colonna personalizzata con template -->
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Layout verticale: Titolo sopra, Data sotto -->
                                        <StackPanel Margin="5">
                                            <!-- Titolo in grassetto -->
                                            <TextBlock Text="{Binding Title}" 
                                                       FontWeight="Bold" 
                                                       FontSize="14"
                                                       TextWrapping="Wrap"/>
                                            <!-- Data in grigio e font più piccolo -->
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}" 
                                                       FontSize="11"
                                                       Foreground="Gray"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            
            <!-- COLONNA CENTRO: Form per CRUD (Create, Read, Update, Delete) -->
            <Border Grid.Column="1" 
                    BorderBrush="LightGray" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="10"
                    Margin="5,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Intestazione della sezione -->
                        <TextBlock Text="Article Management" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>
                        
                        <!-- GroupBox con i campi dati dell'articolo -->
                        <GroupBox Header="Article Data" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Campo Titolo -->
                                <Label Content="Title:"/>
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                                
                                <!-- Campo Contenuto (textarea multilinea) -->
                                <Label Content="Content:"/>
                                <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="250" 
                                         TextWrapping="Wrap" 
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- GroupBox con i pulsanti delle operazioni -->
                        <GroupBox Header="Operations" Padding="10">
                            <!-- UniformGrid: griglia 2x2 con celle di dimensioni uguali -->
                            <UniformGrid Columns="2">
                                <!-- Pulsante Crea: salva un nuovo articolo -->
                                <Button Content="Create New" 
                                        Command="{Binding CreateArticleCommand}"
                                        Background="LightGreen"/>
                                <!-- Pulsante Aggiorna: modifica l'articolo selezionato -->
                                <Button Content="Update" 
                                        Command="{Binding UpdateArticleCommand}"
                                        Background="LightBlue"/>
                                <!-- Pulsante Elimina: cancella l'articolo selezionato -->
                                <Button Content="Delete" 
                                        Command="{Binding DeleteArticleCommand}"
                                        Background="LightCoral"/>
                                <!-- Pulsante Deseleziona: pulisce il form -->
                                <Button Content="Deselect" 
                                        Command="{Binding DeselectCommand}"
                                        Background="LightYellow"/>
                            </UniformGrid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- COLONNA DESTRA: Filtri di ricerca -->
            <Border Grid.Column="2" 
                    BorderBrush="LightGray" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="10"
                    Margin="5,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Intestazione della sezione -->
                        <TextBlock Text="Filtri di Ricerca" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>
                        
                        <!-- FILTRO: Ricerca per titolo -->
                        <GroupBox Header="Ricerca per Titolo" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- TextBox per inserire il titolo da cercare -->
                                <TextBox Text="{Binding SearchTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,5"/>
                                <!-- Pulsante per eseguire la ricerca -->
                                <Button Content="Cerca per Titolo" 
                                        Command="{Binding SearchByTitleCommand}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- FILTRO: Ricerca per contenuto -->
                        <GroupBox Header="Ricerca per Contenuto" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- TextBox per inserire il contenuto da cercare -->
                                <TextBox Text="{Binding SearchContent, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,5"/>
                                <!-- Pulsante per eseguire la ricerca -->
                                <Button Content="Cerca per Contenuto" 
                                        Command="{Binding SearchByContentCommand}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- FILTRO: Ricerca per data singola -->
                        <GroupBox Header="Ricerca per Data" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- DatePicker per selezionare una data (binding diretto senza converter) -->
                                <DatePicker SelectedDate="{Binding SearchDate}"
                                           Margin="0,0,0,5"/>
                                <!-- Griglia 1x2 per due pulsanti affiancati -->
                                <UniformGrid Columns="2">
                                    <!-- Pulsante Cerca: mostra gli articoli della data selezionata -->
                                    <Button Content="Cerca" 
                                            Command="{Binding SearchByDateCommand}"/>
                                    <!-- Pulsante Conta: mostra solo il numero di articoli -->
                                    <Button Content="Conta" 
                                            Command="{Binding GetCountByDateCommand}"/>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- FILTRO: Ricerca per periodo (range di date) -->
                        <GroupBox Header="Ricerca per Periodo" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Data di inizio periodo (binding diretto senza converter) -->
                                <Label Content="Data Inizio:" Margin="0"/>
                                <DatePicker SelectedDate="{Binding StartDate}"/>
                                
                                <!-- Data di fine periodo (binding diretto senza converter) -->
                                <Label Content="Data Fine:" Margin="0,10,0,0"/>
                                <DatePicker SelectedDate="{Binding EndDate}"/>
                                
                                <!-- Pulsante per cercare nel periodo selezionato -->
                                <Button Content="Cerca nel Periodo" 
                                        Command="{Binding SearchByPeriodCommand}"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Pulsante per ricaricare tutti gli articoli (reset filtri) -->
                        <Button Content="Mostra Tutti gli Articoli" 
                                Command="{Binding LoadArticlesCommand}"
                                Margin="0,15,0,0"
                                Background="LightBlue"
                                FontWeight="Bold"
                                Height="40"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <!-- RIGA 2: Barra di stato in basso -->
        <Border Grid.Row="2" 
                Background="#F0F0F0" 
                BorderBrush="LightGray" 
                BorderThickness="0,1,0,0" 
                Padding="10,5"
                Margin="0,10,0,0">
            <!-- 
                TextBlock per mostrare messaggi di stato:
                - Successo/errore operazioni
                - Risultati delle ricerche
                - Conteggi articoli
            -->
            <TextBlock Text="{Binding StatusMessage}" 
                       FontStyle="Italic"
                       FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
